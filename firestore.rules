rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Guests may append analytics rows. They cannot read them.
    // A signed-in organizer (Google sign-in on /admin) can read.
    // The analytics schema has no uid field, so ownership is the signed-in session.
    match /prompt_logs/{logId} {
      allow create: if isValidPromptLog(request.resource.data);
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    match /rsvps/{rsvpId} {
      allow create: if isValidRsvp(request.resource.data);
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidPromptLog(data) {
  return data.keys().hasOnly([
      'ts',
      'feature',
      'route',
      'fallback_reason',
      'latency_ms',
      'input_chars',
      'output_chars',
      'model',
      'confidence',
      'session_id',
      'lang',
      'edited_by_guest'
    ])
    && (!data.keys().hasAny(['edited_by_guest']) || data.edited_by_guest is bool)
    && data.ts is string
    && data.ts.size() >= 20
    && data.ts.size() <= 40
    && data.feature in ['guest_question', 'rsvp', 'song']
    && data.route in ['device', 'cloud', 'sheet']
    && (
      data.fallback_reason == null
      || data.fallback_reason in ['no_model', 'low_confidence', 'long_input', 'no_threshold', 'offline_no_threshold']
    )
    && data.latency_ms is int
    && data.latency_ms >= 0
    && data.latency_ms <= 600000
    && data.input_chars is int
    && data.input_chars >= 0
    && data.input_chars <= 200000
    && data.output_chars is int
    && data.output_chars >= 0
    && data.output_chars <= 200000
    && (
      (data.route == 'sheet' && data.model == null)
      || (
        data.model is string
        && data.model.size() > 0
        && data.model.size() <= 80
      )
    )
    && (data.confidence == null || data.confidence is number)
    && (!data.keys().hasAny(['lang']) || data.lang in ['es', 'en'])
    && data.session_id is string
    && data.session_id.size() >= 8
    && data.session_id.size() <= 80;
}

function mealsOk(tags) {
  return tags.size() == 0
    || (
      tags[0] is string
      && tags[0].matches('^(vegetarian|vegan|gluten_free|kids_menu|allergy:[a-z][a-z0-9_]{0,31})$')
      && mealsOk(tags.removeAll([tags[0]]))
    );
}

function isValidRsvp(data) {
  return data.keys().hasOnly([
      'household_id',
      'attending',
      'party_size',
      'meal_restrictions',
      'kids_count',
      'needs_ride',
      'ambiguous',
      'edited',
      'ts'
    ])
    && data.household_id is string
    && data.household_id.size() >= 4
    && data.household_id.size() <= 40
    && data.household_id.matches('^[A-Za-z0-9-]+$')
    && data.attending in ['yes', 'no', 'maybe']
    && (data.party_size == null || (data.party_size is int && data.party_size >= 1))
    && data.meal_restrictions is list
    && data.meal_restrictions.size() <= 8
    && mealsOk(data.meal_restrictions)
    && (data.kids_count == null || (data.kids_count is int && data.kids_count >= 0))
    && (data.needs_ride == null || data.needs_ride is bool)
    && data.ambiguous is bool
    && data.edited is bool
    && data.ts is string
    && data.ts.size() >= 20
    && data.ts.size() <= 40;
}
