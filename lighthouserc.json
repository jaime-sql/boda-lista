{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173/", "http://127.0.0.1:4173/admin"],
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-gpu --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
