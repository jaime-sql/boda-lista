# Firebase web app config from Project settings. Placeholders only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA Enterprise site key registered for App Check.
VITE_APPCHECK_SITE_KEY=

# Local judging only. Use "true" to print a debug token, or paste a registered token.
# Do not set this for the public Hosting build.
VITE_APPCHECK_DEBUG_TOKEN=

# Set to true to use the Auth and Firestore emulators.
VITE_USE_EMULATORS=

# Optional. Defaults to gemini-3.5-flash-lite.
VITE_GEMINI_CLOUD_MODEL=

# Preview channels and local dev only. Leave unset for production Hosting.
# `npm run dev` allows ?debug=1 even when this is empty.
VITE_ENABLE_DEBUG=
